# =============================================================================
#  CP Student Tracker  -  .env  (LOCAL computer er jonno)
# =============================================================================
#
#  EI FILE KI:
#    app.py chalu hoyar shomoy ei file theke shob setting pore.
#    beecrowd_push.py o ei file theke BACKEND_URL ar INGEST_SECRET pore.
#
#  KIVABE USE KORBE:
#    1. Ei file er naam bodle ".env" koro (shamne dot, pichone kichu na).
#         Linux/Mac :  cp env.local.txt .env
#         Windows   :  copy env.local.txt .env
#       (Notepad e save korle ".env.txt" hoye jete pare - ota cholbe na.)
#    2. ".env" file ta app.py jei folder e, SHEI folder e rakho.
#    3. Niche "<<< BODLAO" lekha line gulo bodlao.
#    4. Kichu bodlale server bondho kore abar chalu koro (python app.py).
#
#  LEKHAR NIYOM:
#    - KEY=value      ->  "=" er dui pashe space dibe na
#    - Quote (" ") lagbe na
#    - "#" diye shuru line = comment, pora hoy na
#    - Comment shobshomoy alada line e likhbe, value er pashe na
#
#  SECURITY:
#    - Ei file KAUKE dibe na, GitHub e push korbe na.
#    - .gitignore file e ".env" line ta likhe dao.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SECRET_KEY   <<< BODLAO
# -----------------------------------------------------------------------------
# Login cookie "sign" korar gopon chabi. Eta jani gele je keu nokol login
# cookie banate parbe, tai lomba random hote hobe.
#
# Banano:  terminal e chalao
#     python -c "import secrets; print(secrets.token_hex(32))"
# je lomba string ashbe seta niche boshao.
#
# Bodlale shobai logout hoye jabe (shudhu abar login korte hobe, data nosto hoy na).
# Na dile server chole, kintu "WARNING: SECRET_KEY is not set" dekhabe - eta
# shudhu testing er jonno, kokhono emon rekhe deploy korbe na.
SECRET_KEY=change-me-run-python-c-import-secrets-print-secrets-token-hex-32


# -----------------------------------------------------------------------------
# 2. INGEST_SECRET   <<< BODLAO
# -----------------------------------------------------------------------------
# Beecrowd script (beecrowd_push.py) ar backend er moddhe gopon chabi.
# Script ei chabi diye proti request e ekta signature banay, backend o same
# chabi diye check kore. Mille tobei data ney, na mille "Bad signature" (401).
#
# Banano: upore er same command abar chalao, NOTUN ekta string nao
#   (SECRET_KEY er sathe same rakhbe na).
#
# Local e shob file ek folder e thakle ei ekta .env e duijon-i pore, tai
# alada kore kothao likhte hobe na.
# Khali rakhle beecrowd data pathano bondho thakbe (503 error).
INGEST_SECRET=change-me-same-value-on-the-beecrowd-computer


# -----------------------------------------------------------------------------
# 3. FRONTEND_ORIGINS
# -----------------------------------------------------------------------------
# Kon address e chola frontend backend ke call korte parbe (CORS).
# Ekhane na thakle browser "CORS error" dibe ar login cookie jabe na.
#   React (create-react-app) -> http://localhost:3000
#   Vite                     -> http://localhost:5173
# Onno port use korle ekhane comma diye jog koro, jemon:
#   FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
# Shesh e "/" dibe na (http://localhost:5173/  <- vul).
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173


# -----------------------------------------------------------------------------
# 4. PUBLIC_READ
# -----------------------------------------------------------------------------
#   1 -> leaderboard, student profile, graph, dashboard login chara shobai dekhbe
#   0 -> egulo dekhte o login lagbe
# Jai dao na keno, kichu BODLATE (student add/edit, sync, import) shob shomoy
# admin/developer login lagbe.
PUBLIC_READ=1


# -----------------------------------------------------------------------------
# 5. SYNC_MODE
# -----------------------------------------------------------------------------
# Codeforces / LeetCode / CodeChef theke data ana (sync) ke chalabe:
#   thread -> server nijei chalay. "Sync" button chaple sathe sathe shuru hoy.
#             LOCAL e eta use koro.
#   queue  -> button chaple sync "line e" thake, bairer scheduled task
#             (python app.py sync) chalay. PythonAnywhere e eta lagbe.
SYNC_MODE=thread


# -----------------------------------------------------------------------------
# 6. AUTO_SYNC  +  AUTO_SYNC_TIME
# -----------------------------------------------------------------------------
# AUTO_SYNC=1 -> protidin AUTO_SYNC_TIME e server nije nije sync korbe.
# AUTO_SYNC=0 -> automatic sync bondho (shudhu button / command diye).
# Shudhu SYNC_MODE=thread hole kaj kore.
#
# AUTO_SYNC_TIME = Dhaka shomoy, 24 ghontar format, HH:MM
#   23:59 = rat 11:59     03:00 = rat 3 ta     14:30 = dupur 2:30
#
# Khial rakho: local e eta tokhoni cholbe jodi oi shomoy computer on thake
# ar "python app.py" chola thake. Computer ghumiye thakle oi diner sync hobe na.
# Ekdin e duibar automatic sync hoy na.
AUTO_SYNC=1
AUTO_SYNC_TIME=23:59


# -----------------------------------------------------------------------------
# 7. COOKIE_SAMESITE  +  COOKIE_SECURE
# -----------------------------------------------------------------------------
# Login cookie kivabe pathano hobe.
#
# LOCAL (localhost:5173 -> localhost:5000):
#   COOKIE_SAMESITE=Lax  ,  COOKIE_SECURE=0
#   (localhost e HTTPS nai, tai SECURE=1 dile login kaj korbe na)
#
# DEPLOY, frontend ALADA domain e (jemon vercel.app -> pythonanywhere.com):
#   COOKIE_SAMESITE=None ,  COOKIE_SECURE=1
#
# DEPLOY, frontend ar backend EKI domain e:
#   COOKIE_SAMESITE=Lax  ,  COOKIE_SECURE=1
COOKIE_SAMESITE=Lax
COOKIE_SECURE=0


# -----------------------------------------------------------------------------
# 8. SESSION_DAYS
# -----------------------------------------------------------------------------
# Ekbar login korle koto din login thakbe (tarpor abar login lagbe).
SESSION_DAYS=7


# -----------------------------------------------------------------------------
# 9. FIRST_USER_EMAIL  +  FIRST_USER_PASSWORD   <<< BODLAO
# -----------------------------------------------------------------------------
# Prothom ADMIN account. Shudhu PROTHOM BAR (database e kono user na thakle)
# eta diye admin toiri hoy. Tarpor ei line bodlale kichui hoy na.
#
# Pore password bodlate:
#   - app e login kore "Change password", othoba
#   - terminal e:  python app.py set-password tomar@email.com
#
# Notun developer/admin account:
#   - app e admin hishebe "Accounts" theke, othoba
#   - terminal e:  python app.py create-user dev@email.com "Naam" developer
FIRST_USER_EMAIL=admin@example.com
FIRST_USER_PASSWORD=admin123


# -----------------------------------------------------------------------------
# 10. SQLITE_WAL
# -----------------------------------------------------------------------------
#   1 -> database ektu druto, sync cholar shomoy leaderboard o smooth.
#        LOCAL e 1 dite paro.
#   0 -> PythonAnywhere e AVOSHYOI 0 (oder network disk e WAL nirapod na).
SQLITE_WAL=1


# -----------------------------------------------------------------------------
# 11. FLASK_DEBUG
# -----------------------------------------------------------------------------
#   1 -> code save korle server nije restart hoy, error er bistarito dekhay.
#        Shudhu LOCAL e.
#   0 -> server e (deploy) shob shomoy 0. 1 rakhle bairer manush error er
#        vitorer code dekhte pare - security problem.
FLASK_DEBUG=1


# -----------------------------------------------------------------------------
# 12. (OPTIONAL) PORT  +  DB_PATH
# -----------------------------------------------------------------------------
# Line er shamne theke "#" muche dile kaj korbe.
#
# Backend kon port e chalbe (default 5000). Bodlale BACKEND_URL o bodlao.
# PORT=5000
#
# Database file kothay thakbe (default: app.py er folder e tracker.db).
# DB_PATH=/home/user/cptracker/tracker.db


# =============================================================================
#  BEECROWD SCRIPT (beecrowd_push.py) er jonno
# =============================================================================
# Script data kothay pathabe.
#   Local backend      -> http://localhost:5000
#   PythonAnywhere e   -> https://<tomar-username>.pythonanywhere.com
# Shesh e "/" dibe na.
# Script INGEST_SECRET upore theke-i pore.
BACKEND_URL=http://localhost:5000


# =============================================================================
#  .env  -  Beecrowd computer er jonno (backend PythonAnywhere e deploy er POR)
# =============================================================================
#
#  Kokhon lagbe:
#    Backend jokhon PythonAnywhere e, ar beecrowd tomar nijer computer e chalaccho.
#    (Local e shob ek folder e thakle eta lagbe na - env.local.txt ei shob ache.)
#
#  Kivabe:
#    1. Ei file ".env" naame beecrowd.py + beecrowd_push.py er folder e rakho.
#    2. Niche duita line bodlao.
#    3. Chalao:  python beecrowd_push.py
#       Thik thakle dekhabe:  "Backend: 12 updated, 0 failed, 0 unknown"
#       "Bad signature"   -> INGEST_SECRET mile nai
#       "connect kora jacche na" -> BACKEND_URL vul ba internet nai
#       "expired X-Timestamp" -> computer er ghori (time) thik koro
# =============================================================================

# Backend er address. https, shesh e "/" chara.
BACKEND_URL=https://<<<tomar-username>>>.pythonanywhere.com

# PythonAnywhere er .env er INGEST_SECRET er sathe HUBOHU EK.
INGEST_SECRET=<<<PythonAnywhere-er-same-string>>>