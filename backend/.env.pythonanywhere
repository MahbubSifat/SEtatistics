# =============================================================================
#  CP Student Tracker  -  .env  (PythonAnywhere SERVER er jonno)
# =============================================================================
#
#  KIVABE USE KORBE:
#    1. "<<< BODLAO" line gulo bodlao.
#    2. PythonAnywhere -> Files -> /home/<username>/cptracker/ folder e
#       ".env" naame save koro (app.py er pashe).
#    3. Web tab -> "Reload" chapo. (.env bodlale proti bar Reload lagbe.)
#    4. Tasks tab -> Scheduled task, protidin 17:59 (UTC) e:
#           cd /home/<username>/cptracker && python3 app.py sync
#       17:59 UTC = Dhaka rat 11:59. Etai daily automatic sync.
#
#  Local .env theke ki ki alada (ar keno), proti line er upore lekha ache.
# =============================================================================


# Notun random string. Local er ta copy korbe na.
# Banano: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<<<BODLAO-notun-random-string>>>

# Beecrowd chabi. Tomar computer er beecrowd .env e EKDOM EI string ta-i dite hobe.
INGEST_SECRET=<<<BODLAO-arekta-random-string>>>

# Tomar frontend er ashol address (https, shesh e "/" chara).
# Ekadhik hole comma diye.
FRONTEND_ORIGINS=https://<<<BODLAO>>>.vercel.app

# Leaderboard shobai dekhbe.
PUBLIC_READ=1

# PythonAnywhere er web app e background thread thik moto chole na,
# tai sync chalabe Scheduled task. Button chaple sync queue te jay.
SYNC_MODE=queue

# Server er nijer ghori bondho - Scheduled task (17:59 UTC) ei kaj kore.
AUTO_SYNC=0

# Frontend ALADA domain e (vercel/netlify) -> None + 1
# Frontend EKI domain e (pythonanywhere theke-i serve) -> Lax + 1
COOKIE_SAMESITE=None
COOKIE_SECURE=1

SESSION_DAYS=7

# Server e prothom bar chalu hole ei diye admin toiri hoy.
# Login korar sathe sathe password bodle nio.
FIRST_USER_EMAIL=<<<BODLAO-tomar-email>>>
FIRST_USER_PASSWORD=<<<BODLAO-strong-password>>>

# PythonAnywhere er disk e WAL nirapod na - AVOSHYOI 0.
SQLITE_WAL=0

# Server e debug kokhono chalu na.
FLASK_DEBUG=0